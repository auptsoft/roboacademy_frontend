# Copy to .env.prod on the server and fill in real values. .env.prod is never committed.
# Used by docker-compose.prod.yml.

# Images pushed by the "Build and deploy" GitHub Actions workflow. The workflow overwrites
# these two lines on the server before each deploy - see .github/workflows/deploy.yml.
WEB_IMAGE=ghcr.io/auptsoft/roboacademy_frontend/web:latest
ADMIN_IMAGE=ghcr.io/auptsoft/roboacademy_frontend/admin:latest

# Runtime config for the built apps - read by entrypoint.sh inside each container at startup
# and exposed to the page via window.__env__ (see apps/*/entrypoint.sh and
# apps/*/src/lib/runtime-env.ts). Both containers load this same file; each ignores the keys
# it doesn't use.
VITE_API_BASE_URL=https://roboapi.greenedge-resources.com
VITE_PLATFORM_TENANT_ID=00000000-0000-0000-0000-0000000b0000

# web only - botnova_go simulation service addresses (see documentation/botnova-embed-contract.md)
VITE_BOTNOVA_API_BASE_URL=
VITE_BOTNOVA_WS_URL=
VITE_BOTNOVA_EMBED_ORIGIN=
