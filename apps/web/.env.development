VITE_API_BASE_URL=https://roboapi.greenedge-resources.com
VITE_PLATFORM_TENANT_ID=00000000-0000-0000-0000-0000000b0000

# The simulation engine runs cross-origin in an iframe and calls botnova_go directly, so it needs
# that service's addresses handed to it in the `init` message - it cannot infer them from the
# host page. See documentation/botnova-embed-contract.md.
VITE_BOTNOVA_API_BASE_URL=http://localhost:5050/api
VITE_BOTNOVA_WS_URL=ws://localhost:5050
# Origin of the embed bundle itself, used to validate inbound postMessage traffic.
VITE_BOTNOVA_EMBED_ORIGIN=http://localhost:3005
